# See http://help.github.com/ignore-files/ for more about ignoring files.

/doc
*.bat
*.ps1
*.cmd
# Committed e2e orchestrator wrapper (see scripts/e2e-test.mjs) — must stay tracked
!/e2eTest.cmd
/*.sql
# Claude Code local config stays out; the committed skill stubs under .claude/skills/ stay in.
# Must be ".claude/*" and not ".claude" — git does not descend into an ignored directory,
# so a negation inside one would never apply.
.claude/*
!.claude/skills/
.claude/settings.local.json
nul
tmpclaude-*
__pycache__/
*.pyc

# Locally exported connector API keys in PLAINTEXT (see ConnectorApiKeyCsvExportTest) — never commit
backend/grafioschtrader-server/src/test/resources/local-seed/

# Playwright artefact trees from "npx playwright test --output=target/...", used when the
# default test-results directory is wedged. Traces of a single spec reach tens of megabytes.
/target/

# Installation-specific Java truststore generated by docker/import-java-certificate.sh
/docker/config/gt-cacerts
