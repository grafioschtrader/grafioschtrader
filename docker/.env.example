# Grafioschtrader Docker configuration.
# Copy to ".env" and fill in the values — or simply run ./install.sh, which asks
# a few questions, generates the secrets and writes this file for you.

# ---------------------------------------------------------------------------
# Required secrets (install.sh generates strong random values)
# ---------------------------------------------------------------------------
# MariaDB root password (used for backups and maintenance only)
DB_ROOT_PASSWORD=
# MariaDB application user password
DB_PASSWORD=
# JWT signing secret — MUST be at least 32 characters (HS256)
JWT_SECRET=

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# The user who registers with this email address receives admin rights.
# Also used as the Let's Encrypt account email.
ADMIN_EMAIL=
# Maximum number of users that can be enabled
GT_ALLOWED_USERS=20

# ---------------------------------------------------------------------------
# Site address / TLS
# ---------------------------------------------------------------------------
# Leave as ":80" for plain HTTP on the local network (access via IP or localhost).
# Set to a domain (e.g. myhost.duckdns.org or gt.example.com) for automatic
# HTTPS via Let's Encrypt — ports 80 and 443 must then be reachable from the
# internet (router port forwarding!).
GT_SITE_ADDRESS=:80

# Host ports published on THIS machine. Change these only if ports 80/443 are
# already taken by another service (a reverse proxy, Home Assistant, ...).
# Note: automatic HTTPS via Let's Encrypt only works on the standard 80/443;
# on other ports run local HTTP (GT_SITE_ADDRESS=:80) or put GT behind an
# existing reverse proxy that terminates TLS.
GT_HTTP_PORT=80
GT_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# DuckDNS dynamic DNS (optional — for home servers without a static IP)
# ---------------------------------------------------------------------------
# Uncomment the next line to enable the DuckDNS updater container:
#COMPOSE_PROFILES=duckdns
# Your DuckDNS subdomain WITHOUT ".duckdns.org" (e.g. "myhost")
DUCKDNS_SUBDOMAIN=
# Your DuckDNS token from https://www.duckdns.org
DUCKDNS_TOKEN=

# ---------------------------------------------------------------------------
# Mail / SMTP (strongly recommended — user registration sends a confirmation
# email; without SMTP no new users can complete registration)
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
# Port 465 -> MAIL_SMTP_SSL=true,  MAIL_SMTP_STARTTLS=false
# Port 587 -> MAIL_SMTP_SSL=false, MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false

# ---------------------------------------------------------------------------
# Sizing (defaults suit a 4 GB host; install.sh picks these automatically)
# ---------------------------------------------------------------------------
#   2 GB host:  JAVA_OPTS=-Xms128m -Xmx896m    DB_INNODB_BUFFER_POOL_SIZE=384M
#   4 GB host:  JAVA_OPTS=-Xms256m -Xmx1792m   DB_INNODB_BUFFER_POOL_SIZE=1G
#   8 GB host:  JAVA_OPTS=-Xms512m -Xmx2048m   DB_INNODB_BUFFER_POOL_SIZE=2G
JAVA_OPTS=-Xms256m -Xmx1792m
DB_INNODB_BUFFER_POOL_SIZE=1G

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------
# Image tag to run ("latest" or a specific version like "0.36.7.2")
GT_VERSION=latest
# Database and user name (rarely need changing)
DB_NAME=grafioschtrader
DB_USER=grafioschtrader
# Enable WebSocket push updates (experimental)
GT_USE_WEBSOCKET=false
