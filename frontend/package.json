{
  "name": "grafioschtrader-client",
  "version": "0.36.8",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve frontend --proxy-config proxy.conf.json",
    "build": "ng build frontend",
    "watch": "ng build frontend --watch --configuration development",
    "buildprod": "ng build frontend --configuration production --base-href /grafioschtrader/",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:setup": "playwright test --project=setup --headed",
    "e2e:tests": "playwright test --project=grafioschtrader-e2e --no-deps --headed",
    "e2e:lib": "playwright test --config=playwright.lib.config.ts",
    "e2e:lib:headed": "playwright test --config=playwright.lib.config.ts --headed",
    "start:grafiosch": "ng serve grafiosch-host --port 4201 --proxy-config proxy.grafiosch-host.conf.json",
    "start:grafiosch-peer": "ng serve grafiosch-host --port 4202 --proxy-config proxy.grafiosch-host-peer.conf.json",
    "start:gt-peer": "ng serve frontend --port 4202 --proxy-config proxy.gt-peer.conf.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.1",
    "@openng/optimus-ui-themes": "^2.0.1",
    "angular-svg-icon": "^19.0.1",
    "bootstrap": "^5.3.3",
    "class-transformer": "^0.5.1",
    "copee": "^1.0.6",
    "deepmerge": "^4.2.2",
    "flag-icons": "^6.6.6",
    "font-awesome": "^4.7.0",
    "js-yaml": "^4.1.1",
    "moment": "^2.29.1",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.4.1",
    "ngx-file-drop": "^16.0.0",
    "normalize.css": "^8.0.1",
    "plotly.js": "^3.0.0",
    "plotly.js-locales": "^3.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.0",
    "split.js": "^1.6.2",
    "tippy.js": "^6.3.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/language-service": "^22.1.3",
    "@playwright/test": "^1.59.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/plotly.js": "^2.12.11",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
