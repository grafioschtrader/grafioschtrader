{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "aot": true,
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "tsConfig": "./tsconfig.app.json",
            "polyfills": [],
            "assets": [
              "src/assets",
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "/vs"
              },
              {
                "glob": "*.json",
                "input": ".generated/schemas",
                "output": "/assets/schemas"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/normalize.css/normalize.css",
              "node_modules/@openng/icons/openng-icons.css",
              "node_modules/font-awesome/css/font-awesome.min.css",
              "node_modules/flag-icons/css/flag-icons.min.css",
              "src/assets/theme.css",
              "src/styles.css",
              "src/app/lib/styles.css"
            ],
            "scripts": ["node_modules/split.js/dist/split.js", "node_modules/reflect-metadata/Reflect.js"],
            "allowedCommonJsDependencies": ["moment", "angular2-uuid", "plotly.js"],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.75mb",
                  "maximumError": "3.25mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "150kb",
                  "maximumError": "200kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "outputHashing": "media"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "buildTarget": "frontend:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "frontend:build"
          }
        }
      }
    },
    "grafiosch-host": {
      "root": "",
      "sourceRoot": "src/grafiosch-host",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "aot": true,
            "outputPath": {
              "base": "dist/grafiosch-host"
            },
            "index": "src/grafiosch-host/index.html",
            "browser": "src/grafiosch-host/main.ts",
            "tsConfig": "./tsconfig.grafiosch-host.json",
            "polyfills": [],
            "assets": [
              "src/assets",
              {
                "glob": "*.json",
                "input": ".generated/schemas",
                "output": "/assets/schemas"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/normalize.css/normalize.css",
              "node_modules/@openng/icons/openng-icons.css",
              "node_modules/font-awesome/css/font-awesome.min.css",
              "src/assets/theme.css",
              "src/styles.css",
              "src/app/lib/styles.css",
              "src/grafiosch-host/styles.css"
            ],
            "scripts": ["node_modules/split.js/dist/split.js", "node_modules/reflect-metadata/Reflect.js"],
            "allowedCommonJsDependencies": ["moment"]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201,
            "buildTarget": "grafiosch-host:build"
          }
        }
      }
    },
    "gt-mobile": {
      "root": "",
      "sourceRoot": "src/gt-mobile",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "aot": true,
            "outputPath": {
              "base": "dist/browser/m",
              "browser": ""
            },
            "index": "src/gt-mobile/index.html",
            "browser": "src/gt-mobile/main.ts",
            "tsConfig": "./tsconfig.gt-mobile.json",
            "polyfills": [],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/gt-mobile/assets",
                "output": "/assets"
              },
              {
                "glob": "manifest.webmanifest",
                "input": "src/gt-mobile",
                "output": "/"
              }
            ],
            "styles": [
              "node_modules/@ionic/angular/css/core.css",
              "node_modules/@ionic/angular/css/normalize.css",
              "node_modules/@ionic/angular/css/structure.css",
              "node_modules/@ionic/angular/css/typography.css",
              "node_modules/@ionic/angular/css/padding.css",
              "node_modules/@ionic/angular/css/text-alignment.css",
              "node_modules/@ionic/angular/css/palettes/dark.system.css",
              "src/gt-mobile/styles.css"
            ],
            "allowedCommonJsDependencies": ["moment", "plotly.js"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "1.5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "16kb"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "src/gt-mobile/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4203,
            "buildTarget": "gt-mobile:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "gt-mobile:build:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
