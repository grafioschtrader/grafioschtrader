# See http://help.github.com/ignore-files/ for more about ignoring files.

.angular/*
# compiled output
/dist
/prod
/tmp
/out-tsc

# dependencies
/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
testem.log
package-lock.json
/typings

# e2e
/e2e/*.js
/e2e/*.map
/e2e/.auth/
# Where the timing reporter writes e2e-timing.json (next to the config's rootDir, i.e. the testDir).
/e2e/test-results/
/e2e/lib/test-results/
# Also covers the fallback directories scripts/e2e-test.mjs creates when Windows keeps a handle on
# the artifact tree: test-results.stale-<ts>/ and test-results-<ts>/.
/test-results*/
/playwright-report/

# System Files
.DS_Store
Thumbs.db

# Claude Code temporary files
tmpclaude-*
