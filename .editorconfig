# Editor configuration, see http://editorconfig.org
# Repository-wide floor for every editor and coding agent. The authoritative
# formatters are Prettier (frontend, .prettierrc.json) and Spotless driven by
# gt-code-style/backend/eclipse/gt-java-formatting.xml (backend).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Executed by cmd.exe / PowerShell, must keep CRLF (see .gitattributes)
[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
max_line_length = off
trim_trailing_whitespace = false
